{
  "name": "chasethedeveloperv2",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "audit:deps": "yarn audit --audit-level=moderate --registry=https://registry.npmjs.org --production",
    "audit:unused:deps": "npx depcheck . --config=.depcheckrc.json",
    "dev": "next dev",
    "build": "next build",
    "build:worker": "npx @opennextjs/cloudflare build",
    "start": "next start",
    "lint": "eslint src --fix",
    "test": "jest",
    "preview": "npm run build:worker && wrangler pages dev",
    "prepare": "npx husky install",
    "pipeline.readiness.check": "yarn run audit:unused:deps && yarn run audit:deps && yarn run lint && yarn run build && yarn run test"
  },
  "dependencies": {
    "next": "^15.5.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.15.5",
    "@babel/preset-env": "^7.15.6",
    "@babel/preset-react": "^7.14.5",
    "@babel/preset-typescript": "^7.15.0",
    "@commitlint/cli": "^13.1.0",
    "@commitlint/config-conventional": "^13.1.0",
    "@opennextjs/cloudflare": "^1.15.1",
    "@popperjs/core": "^2.10.1",
    "@testing-library/dom": "^8.5.0",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "bootstrap": "^5.1.1",
    "classnames": "^2.3.1",
    "eslint": "^8.56.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-next": "^15.5.9",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jest": "^27.6.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.0",
    "husky": "^7.0.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0",
    "vercel": "^50.5.0",
    "wrangler": "^3.0.0"
  }
}
